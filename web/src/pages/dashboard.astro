---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Dashboard Prediksi">
  <div class="fade-in">
    <div class="page-section-header" style="margin-bottom:20px;">
      <h2 class="section-title" style="font-size:1.2rem;">🗺️ DASHBOARD PREDIKSI SIKLON</h2>
    </div>

    <!-- Radius Slider -->
    <div class="page-panel" style="margin-bottom:16px;">
      <div class="form-group" style="margin:0;">
        <label class="form-label">🎯 Radius dari Sumatera Barat (km): <span id="radius-val">1500</span> km</label>
        <input type="range" id="radius-slider" min="500" max="4000" step="250" value="1500"
          style="width:100%; accent-color:#1E3A8A; height:6px; cursor:pointer;" />
        <div style="display:flex; justify-content:space-between; font-size:11px; color:#9CA3AF; margin-top:4px;">
          <span>500 km</span><span>4000 km</span>
        </div>
      </div>
    </div>

    <!-- Filter & Select SID -->
    <div style="display:grid; grid-template-columns: 120px 1fr; gap:12px; align-items:end; margin-bottom:16px;">
      <div id="sid-count-badge" class="metric-card" style="padding:10px; text-align:center;">
        <div class="metric-label" style="font-size:10px;">Siklon</div>
        <div class="metric-value" style="font-size:24px;" id="sid-count">–</div>
      </div>
      <div class="form-group" style="margin:0;">
        <label class="form-label" for="sid-select">🆔 Pilih ID Siklon</label>
        <select id="sid-select" class="form-select">
          <option>Memuat data...</option>
        </select>
      </div>
    </div>

    <!-- Cyclone Info -->
    <div id="cyclone-info" class="page-panel" style="display:none; margin-bottom:16px;">
      <div class="grid-2" style="gap:10px;">
        <div id="info-left" style="font-size:0.88rem; line-height:1.9; font-weight:600;"></div>
        <div id="info-right" style="font-size:0.88rem; line-height:1.9; font-weight:600;"></div>
      </div>
    </div>

    <!-- Map -->
    <div class="page-panel" style="padding:0; overflow:hidden; margin-bottom:16px;">
      <div style="padding:12px 16px; border-bottom:1px solid #E5E7EB;">
        <span style="font-weight:700; font-size:0.9rem; color:#1E3A8A;">🗺️ Visualisasi Peta Lintasan</span>
      </div>
      <div id="dashboard-map" class="map-container" style="height:520px;"></div>
    </div>

    <!-- Metrics -->
    <div class="grid-2" style="gap:16px; margin-bottom:16px;">
      <div class="metric-card">
        <div class="metric-label">RMSE (km)</div>
        <div class="metric-value" id="metric-rmse">–</div>
      </div>
      <div class="metric-card">
        <div class="metric-label">MAE (km)</div>
        <div class="metric-value" id="metric-mae">–</div>
      </div>
    </div>

    <!-- Table -->
    <div class="page-panel">
      <div style="font-weight:800; font-size:0.9rem; color:#1E3A8A; margin-bottom:12px;">📋 Tabel Perbandingan Koordinat</div>
      <div class="custom-table-wrapper" id="table-wrapper">
        <div style="text-align:center; padding:24px; color:#9CA3AF;">Pilih siklon untuk melihat data.</div>
      </div>
    </div>
  </div>
</Layout>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
// Leaflet loaded dynamically
async function loadLeaflet() {
  if ((window as any).L) return (window as any).L;
  await new Promise<void>((resolve) => {
    const s = document.createElement('script');
    s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    s.onload = () => resolve();
    document.head.appendChild(s);
  });
  return (window as any).L;
}

const PADANG_LAT = -0.94;
const PADANG_LON = 100.32;

function haversine(lat1: number, lon1: number, lat2: number, lon2: number): number {
  const R = 6371;
  const dLat = ((lat2 - lat1) * Math.PI) / 180;
  const dLon = ((lon2 - lon1) * Math.PI) / 180;
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R * 2 * Math.asin(Math.sqrt(a));
}

interface PredRow { SID:string; NAME?:string; ISO_TIME:string; LAT_ACTUAL:number; LON_ACTUAL:number; LAT_PRED:number; LON_PRED:number; ERROR_KM:number; }
interface TestRow { SID:string; NAME?:string; ISO_TIME:string; LAT:number; LON:number; }

let predData: PredRow[] = [];
let testData: TestRow[] = [];
let mapInstance: any = null;

function parseCsv(text: string) {
  const lines = text.trim().split('\n');
  const headers = lines[0].split(',').map(h => h.trim().replace(/"/g,''));
  return lines.slice(1).map(line => {
    const vals: string[] = [];
    let inQ = false, cur = '';
    for (const ch of line) {
      if (ch==='"') { inQ=!inQ; continue; }
      if (ch===',' && !inQ) { vals.push(cur.trim()); cur=''; continue; }
      cur += ch;
    }
    vals.push(cur.trim());
    return Object.fromEntries(headers.map((h,i) => [h, vals[i]??'']));
  });
}

async function init() {
  const [predText, testText] = await Promise.all([
    fetch('/data/predictions_gab8.csv').then(r => r.text()),
    fetch('/data/model_gab_test_fix.csv').then(r => r.text()),
  ]);
  const predRaw = parseCsv(predText);
  predData = predRaw.map(r => ({
    SID: r['SID']??'', NAME: r['NAME'], ISO_TIME: r['ISO_TIME']??'',
    LAT_ACTUAL: parseFloat(r['LAT_ACTUAL']??'0'), LON_ACTUAL: parseFloat(r['LON_ACTUAL']??'0'),
    LAT_PRED: parseFloat(r['LAT_PRED']??'0'), LON_PRED: parseFloat(r['LON_PRED']??'0'),
    ERROR_KM: parseFloat(r['ERROR_KM']??'0'),
  }));
  const testRaw = parseCsv(testText);
  testData = testRaw.map(r => ({
    SID: r['SID']??'', NAME: r['NAME'], ISO_TIME: r['ISO_TIME']??'',
    LAT: parseFloat(r['LAT']??'0'), LON: parseFloat(r['LON']??'0'),
  }));

  // Compute distances
  const distMap = new Map<string, number>();
  for (const row of predData) {
    const d = haversine(row.LAT_ACTUAL, row.LON_ACTUAL, PADANG_LAT, PADANG_LON);
    const cur = distMap.get(row.SID) ?? Infinity;
    if (d < cur) distMap.set(row.SID, d);
  }

  const slider = document.getElementById('radius-slider') as HTMLInputElement;
  const radiusVal = document.getElementById('radius-val')!;

  function filterAndRender(radius: number) {
    radiusVal.textContent = radius.toString();
    const filtered = [...new Set(predData.filter(r => (distMap.get(r.SID)??Infinity) <= radius).map(r => r.SID))];
    const sids = filtered.length > 0 ? filtered : [...new Set(predData.map(r => r.SID))];
    document.getElementById('sid-count')!.textContent = sids.length.toString();
    const sel = document.getElementById('sid-select') as HTMLSelectElement;
    const prev = sel.value;
    sel.innerHTML = sids.map(s => `<option value="${s}">${s}</option>`).join('');
    if (sids.includes(prev)) sel.value = prev;
    renderSID(sel.value);
  }

  slider.addEventListener('input', () => filterAndRender(parseInt(slider.value)));
  document.getElementById('sid-select')!.addEventListener('change', (e) => renderSID((e.target as HTMLSelectElement).value));

  const L = await loadLeaflet();
  mapInstance = L.map('dashboard-map', { center: [-10, 90], zoom: 4 });
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
  }).addTo(mapInstance);

  filterAndRender(1500);
}

function renderSID(sid: string) {
  if (!sid) return;
  const preds = predData.filter(r => r.SID === sid).sort((a,b) => a.ISO_TIME.localeCompare(b.ISO_TIME));
  const tests = testData.filter(r => r.SID === sid).sort((a,b) => a.ISO_TIME.localeCompare(b.ISO_TIME));

  // Merge
  const merged = preds.map(p => {
    const t = tests.find(t2 => t2.ISO_TIME === p.ISO_TIME);
    return { ...p, LAT: t?.LAT ?? p.LAT_ACTUAL, LON: t?.LON ?? p.LON_ACTUAL };
  });
  if (!merged.length) return;

  // Info
  const first = merged[0], last = merged[merged.length-1];
  const name = tests[0]?.NAME ?? 'N/A';
  const durHours = Math.round((new Date(last.ISO_TIME).getTime() - new Date(first.ISO_TIME).getTime()) / 3_600_000);
  document.getElementById('cyclone-info')!.style.display = 'block';
  document.getElementById('info-left')!.innerHTML =
    `🆔 <b>ID Siklon</b>: <code>${sid}</code><br>🏷️ <b>Nama</b>: <code>${name}</code><br>⏱️ <b>Interval</b>: <code>3 Jam</code>`;
  document.getElementById('info-right')!.innerHTML =
    `📅 <b>Periode</b>: <code>${new Date(first.ISO_TIME).toLocaleDateString('id-ID')} – ${new Date(last.ISO_TIME).toLocaleDateString('id-ID')}</code><br>⏳ <b>Durasi</b>: <code>${durHours} jam</code><br>📌 <b>Jumlah titik</b>: <code>${merged.length}</code>`;

  // Metrics
  const errors = merged.map(r => r.ERROR_KM);
  const rmse = Math.sqrt(errors.reduce((s,e) => s + e**2, 0) / errors.length);
  const mae = errors.reduce((s,e) => s + e, 0) / errors.length;
  document.getElementById('metric-rmse')!.textContent = rmse.toFixed(2);
  document.getElementById('metric-mae')!.textContent = mae.toFixed(2);

  // Map
  if (mapInstance) {
    const L = (window as any).L;
    mapInstance.eachLayer((l: any) => { if (l._url === undefined) mapInstance.removeLayer(l); });

    const actualPts = merged.map(r => [r.LAT, r.LON] as [number,number]);
    const predPts = merged.map(r => [r.LAT_PRED, r.LON_PRED] as [number,number]);

    L.polyline(actualPts, { color: '#111827', weight: 3 }).bindTooltip('Aktual').addTo(mapInstance);
    L.polyline(predPts, { color: '#1E3A8A', weight: 3, dashArray: '8 6' }).bindTooltip('Prediksi').addTo(mapInstance);

    for (const r of merged) {
      L.circleMarker([r.LAT, r.LON], { radius: 4, color: '#111827', fillColor: 'white', fillOpacity: 1, weight: 1.5 }).addTo(mapInstance);
      L.circleMarker([r.LAT_PRED, r.LON_PRED], { radius: 4, color: '#1E3A8A', fillColor: 'white', fillOpacity: 1, weight: 1.5 }).addTo(mapInstance);
    }
    L.circleMarker(actualPts[0], { radius: 8, color: 'green', fillColor: 'green', fillOpacity: 1 }).bindTooltip('Start').addTo(mapInstance);
    L.circleMarker(actualPts[actualPts.length-1], { radius: 8, color: '#1E3A8A', fillColor: '#1E3A8A', fillOpacity: 1 }).bindTooltip('End').addTo(mapInstance);

    const allLats = [...actualPts, ...predPts].map(p => p[0]);
    const allLons = [...actualPts, ...predPts].map(p => p[1]);
    mapInstance.fitBounds([[Math.min(...allLats)-1, Math.min(...allLons)-1],[Math.max(...allLats)+1, Math.max(...allLons)+1]]);
  }

  // Table
  const tHead = `<tr><th>Waktu</th><th>LAT Aktual</th><th>LON Aktual</th><th>LAT Prediksi</th><th>LON Prediksi</th><th>Error (km)</th></tr>`;
  const tBody = merged.map(r => `<tr>
    <td>${new Date(r.ISO_TIME).toLocaleString('id-ID',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'})}</td>
    <td>${r.LAT.toFixed(4)}°</td><td>${r.LON.toFixed(4)}°</td>
    <td>${r.LAT_PRED.toFixed(4)}°</td><td>${r.LON_PRED.toFixed(4)}°</td>
    <td>${r.ERROR_KM.toFixed(2)}</td>
  </tr>`).join('');
  document.getElementById('table-wrapper')!.innerHTML = `<table class="custom-table"><thead>${tHead}</thead><tbody>${tBody}</tbody></table>`;
}

init().catch(console.error);
</script>

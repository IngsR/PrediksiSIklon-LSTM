---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Prediksi Siklon">
  <div class="fade-in">
    <div class="page-section-header" style="margin-bottom:16px;">
      <h2 class="section-title" style="font-size:1.15rem;">🔮 Prediksi Lintasan Siklon (LSTM)</h2>
      <p class="section-subtitle">Input titik observasi secara interaktif dan jalankan prediksi lintasan siklon untuk horizon 3–9 jam.</p>
    </div>

    <div class="split-layout" style="align-items:start;">
      <!-- ===== KIRI: EDITOR ===== -->
      <div>
        <div class="page-panel">
          <div class="page-section-header">
            <h2 class="section-title">📝 Editor Observasi</h2>
            <p class="section-subtitle">Masukkan titik observasi historis, atur waktu awal, lalu jalankan prediksi LSTM.</p>
          </div>

          <!-- Point Selector -->
          <div class="form-group">
            <label class="form-label" for="point-select">Pilih Nomor Titik untuk Diedit</label>
            <select id="point-select" class="form-select"></select>
          </div>

          <!-- Point Editor Form -->
          <div id="point-editor" class="grid-2" style="gap:10px; margin-bottom:14px;">
            <div>
              <div class="form-group">
                <label class="form-label" for="inp-lat">Latitude (°)</label>
                <input type="number" id="inp-lat" class="form-input" step="0.1" value="0" />
              </div>
              <div class="form-group">
                <label class="form-label" for="inp-wind">WMO Wind (knot)</label>
                <input type="number" id="inp-wind" class="form-input" step="1" value="115" />
              </div>
            </div>
            <div>
              <div class="form-group">
                <label class="form-label" for="inp-lon">Longitude (°)</label>
                <input type="number" id="inp-lon" class="form-input" step="0.1" value="0" />
              </div>
              <div class="form-group">
                <label class="form-label" for="inp-pres">WMO Pressure (hPa)</label>
                <input type="number" id="inp-pres" class="form-input" step="1" value="1005" />
              </div>
            </div>
          </div>
          <button class="btn btn-secondary btn-full" onclick="savePoint()" style="margin-bottom:12px;">✅ Simpan Titik</button>

          <div class="divider"></div>

          <!-- Config -->
          <details open style="margin-bottom:12px;">
            <summary style="font-weight:700; font-size:0.88rem; color:#1E3A8A; cursor:pointer; padding:6px 0;">⚙️ Konfigurasi Prediksi</summary>
            <div style="margin-top:10px;">
              <div class="grid-2" style="gap:10px;">
                <div class="form-group">
                  <label class="form-label" for="inp-date">Tanggal Awal (Titik 1)</label>
                  <input type="date" id="inp-date" class="form-input" />
                </div>
                <div class="form-group">
                  <label class="form-label" for="inp-time">Jam Awal (Titik 1)</label>
                  <input type="time" id="inp-time" class="form-input" value="00:00" />
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="horizon-select">Horizon Prediksi</label>
                <select id="horizon-select" class="form-select">
                  <option value="1">3 Jam (1 Langkah)</option>
                  <option value="2">6 Jam (2 Langkah)</option>
                  <option value="3">9 Jam (3 Langkah)</option>
                </select>
              </div>
            </div>
          </details>

          <div class="divider"></div>

          <!-- Observation Table -->
          <div style="font-weight:700; font-size:0.85rem; color:#1E3A8A; margin-bottom:8px;">📋 Data Observasi (8 Titik)</div>
          <div class="custom-table-wrapper" id="obs-table-wrapper"></div>
        </div>

        <!-- Notice -->
        <div class="page-notice">Klik titik pada peta untuk mengisi koordinat ke titik kosong berikutnya. Pastikan semua titik LAT dan LON terisi sebelum menekan Prediksi.</div>

        <!-- Buttons -->
        <div class="grid-3" style="gap:8px; margin-top:8px;">
          <button class="btn btn-secondary" id="btn-print" disabled onclick="printReport()">📄 Print Laporan</button>
          <button class="btn btn-primary" id="btn-predict" onclick="runPrediction()">🧠 Prediksi LSTM</button>
          <button class="btn btn-danger" onclick="resetAll()">🗑️ Bersihkan</button>
        </div>
      </div>

      <!-- ===== KANAN: PETA & HASIL ===== -->
      <div>
        <div class="page-panel" style="padding:0; overflow:hidden; margin-bottom:14px;">
          <div style="padding:12px 16px; border-bottom:1px solid #E5E7EB;">
            <span style="font-weight:700; font-size:0.9rem; color:#1E3A8A;">🗺️ Visualisasi Jalur</span>
          </div>
          <div id="pred-map" class="map-container" style="height:550px;"></div>
        </div>

        <!-- Results -->
        <div id="results-panel" class="page-panel" style="display:none;">
          <div class="page-section-header">
            <h2 class="section-title">📍 Hasil Prediksi</h2>
            <p class="section-subtitle">Ringkasan hasil prediksi per langkah waktu.</p>
          </div>
          <div id="results-content"></div>
          <div class="page-notice" style="background:#FEF2F2; border-color:#FCA5A5; color:#991B1B; margin-top:12px;">
            <strong>⚠️ Catatan Ilmiah:</strong> Prediksi bersifat <em>data-driven</em> dan probabilistik. Peningkatan horizon waktu (6–9 jam) meningkatkan akumulasi ketidakpastian. Hasil ini sebagai pendukung informasi.
          </div>
        </div>

        <!-- Spinner -->
        <div id="pred-spinner" style="display:none; text-align:center; padding:24px;">
          <div class="spinner" style="width:32px;height:32px;margin:0 auto 12px;"></div>
          <p style="color:#1E3A8A; font-weight:700; margin:0;">⏳ Memproses Prediksi Rekursif...</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
import { generateAndDownloadPdfReport } from '../lib/pdfReport';

const WINDOW_SIZE = 8;

// State
const observations = Array.from({length: WINDOW_SIZE}, () => ({
  LAT: 0, LON: 0, WMO_WIND: 115, WMO_PRES: 1005
}));
let predResults: Array<{pred_lat:number; pred_lon:number; time:string}> = [];
let mapInstance: any = null;

// ── Helpers ───────────────────────────────────────
function haversine(lat1:number,lon1:number,lat2:number,lon2:number):number {
  const R=6371,dLat=(lat2-lat1)*Math.PI/180,dLon=(lon2-lon1)*Math.PI/180;
  const a=Math.sin(dLat/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R*2*Math.asin(Math.sqrt(a));
}
function bearing(lat1:number,lon1:number,lat2:number,lon2:number):number {
  const dLon=(lon2-lon1)*Math.PI/180,φ1=lat1*Math.PI/180,φ2=lat2*Math.PI/180;
  return ((Math.atan2(Math.sin(dLon)*Math.cos(φ2),Math.cos(φ1)*Math.sin(φ2)-Math.sin(φ1)*Math.cos(φ2)*Math.cos(dLon))*180/Math.PI)+360)%360;
}
function formatLat(v:number):string { return `${Math.abs(v).toFixed(1)}° ${v<0?'LS':'LU'}`; }
function formatLon(v:number):string { return `${Math.abs(v).toFixed(1)}° ${v<0?'BB':'BT'}`; }
function getCategory(wind:number):string {
  if(wind>=137) return 'Siklon Kategori 5';
  if(wind>=113) return 'Siklon Kategori 4';
  if(wind>=96)  return 'Siklon Kategori 3';
  if(wind>=83)  return 'Siklon Kategori 2';
  if(wind>=64)  return 'Siklon Kategori 1';
  if(wind>=34)  return 'Badai Tropis';
  return 'Depresi Tropis';
}
function getReliability(step:number) {
  if(step===1) return {text:'Tinggi (92%)',color:'#059669',km:'±15-25 km'};
  if(step===2) return {text:'Sedang (78%)',color:'#D97706',km:'±35-55 km'};
  return {text:'Rendah (61%)',color:'#DC2626',km:'±60-90 km'};
}

// ── Point selector ────────────────────────────────
function initPointSelect() {
  const sel = document.getElementById('point-select') as HTMLSelectElement;
  sel.innerHTML = Array.from({length:WINDOW_SIZE},(_,i)=>`<option value="${i}">Titik ${i+1}</option>`).join('');
  sel.addEventListener('change', () => loadPoint(parseInt(sel.value)));
  loadPoint(0);
}
function loadPoint(idx:number) {
  const p = observations[idx];
  (document.getElementById('inp-lat') as HTMLInputElement).value = p.LAT.toString();
  (document.getElementById('inp-lon') as HTMLInputElement).value = p.LON.toString();
  (document.getElementById('inp-wind') as HTMLInputElement).value = p.WMO_WIND.toString();
  (document.getElementById('inp-pres') as HTMLInputElement).value = p.WMO_PRES.toString();
}
(window as any).savePoint = function() {
  const idx = parseInt((document.getElementById('point-select') as HTMLSelectElement).value);
  observations[idx].LAT = parseFloat((document.getElementById('inp-lat') as HTMLInputElement).value)||0;
  observations[idx].LON = parseFloat((document.getElementById('inp-lon') as HTMLInputElement).value)||0;
  observations[idx].WMO_WIND = parseFloat((document.getElementById('inp-wind') as HTMLInputElement).value)||115;
  observations[idx].WMO_PRES = parseFloat((document.getElementById('inp-pres') as HTMLInputElement).value)||1005;
  renderObsTable();
  renderMap();
};

// ── Observation Table ─────────────────────────────
function getStartDateTime():Date {
  const d=(document.getElementById('inp-date') as HTMLInputElement).value;
  const t=(document.getElementById('inp-time') as HTMLInputElement).value||'00:00';
  return d ? new Date(`${d}T${t}:00`) : new Date();
}
function renderObsTable() {
  const start = getStartDateTime();
  const rows = observations.map((p,i) => {
    const ts = new Date(start.getTime() + i*3*3600*1000);
    const timeStr = ts.toLocaleString('id-ID',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
    const latStr = p.LAT===0?'–':formatLat(p.LAT);
    const lonStr = p.LON===0?'–':formatLon(p.LON);
    return `<tr><td>${i+1}</td><td>${timeStr}</td><td>${latStr}</td><td>${lonStr}</td><td>${p.WMO_WIND.toFixed(1)}</td><td>${p.WMO_PRES.toFixed(1)}</td></tr>`;
  }).join('');
  document.getElementById('obs-table-wrapper')!.innerHTML = `
    <table class="custom-table" style="font-size:12px;">
      <thead><tr><th>#</th><th>Waktu (WIB)</th><th>Lintang</th><th>Bujur</th><th>Angin (knot)</th><th>Tekanan (hPa)</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
}

// ── Map ───────────────────────────────────────────
async function loadLeaflet() {
  if ((window as any).L) return (window as any).L;
  await new Promise<void>(resolve => {
    const s=document.createElement('script');
    s.src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    s.onload=()=>resolve();
    document.head.appendChild(s);
  });
  return (window as any).L;
}

let mapLayers: any[] = [];
function clearMapLayers() {
  if (!mapInstance) return;
  mapLayers.forEach(l => mapInstance.removeLayer(l));
  mapLayers = [];
}
function addLayer(l:any) {
  if (mapInstance) { l.addTo(mapInstance); mapLayers.push(l); }
}

async function renderMap() {
  const L = await loadLeaflet();
  if (!mapInstance) {
    mapInstance = L.map('pred-map', {center:[-10,90], zoom:4});
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
      attribution:'© OpenStreetMap'
    }).addTo(mapInstance);

    // Click on map → fill empty point
    mapInstance.on('click', (e:any) => {
      const lat = Math.round(e.latlng.lat*10)/10;
      const lon = Math.round(e.latlng.lng*10)/10;
      const empty = observations.findIndex(p => p.LAT===0 && p.LON===0);
      if (empty>=0) {
        observations[empty].LAT = lat;
        observations[empty].LON = lon;
        (document.getElementById('point-select') as HTMLSelectElement).value = empty.toString();
        loadPoint(empty);
        renderObsTable();
        renderMap();
      }
    });
  }

  clearMapLayers();
  const valid = observations.filter(p => p.LAT!==0 || p.LON!==0);
  if (valid.length > 0) {
    const pts = valid.map(p => [p.LAT, p.LON] as [number,number]);
    addLayer(L.polyline(pts, {color:'#2563EB', weight:3.5, opacity:0.8}));
    pts.forEach((pt,i) => {
      addLayer(L.circleMarker(pt, {radius:5,color:'#2563EB',fillColor:'white',fillOpacity:1,weight:2})
        .bindTooltip(`Titik ${i+1}: ${formatLat(valid[i].LAT)}, ${formatLon(valid[i].LON)}`));
    });
    if (predResults.length > 0) {
      let prevPt = pts[pts.length-1];
      predResults.forEach((r,i) => {
        const pt:[number,number] = [r.pred_lat, r.pred_lon];
        // Animated dashed line
        addLayer(L.polyline([prevPt, pt], {color:'#DC2626', weight:3, dashArray:'10 6', opacity:0.9}));
        const icon = L.divIcon({
          html:`<div style="background:#DC2626;color:white;border-radius:50%;width:24px;height:24px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:11px;border:2px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.3);">${i+1}</div>`,
          className:'', iconSize:[24,24], iconAnchor:[12,12]
        });
        addLayer(L.marker(pt, {icon}).bindTooltip(
          `Pred ${i+1}: ${formatLat(r.pred_lat)}, ${formatLon(r.pred_lon)}<br>${new Date(r.time).toLocaleString('id-ID')}`
        ));
        prevPt = pt;
      });
    }
    const allPts = [...pts, ...predResults.map(r => [r.pred_lat,r.pred_lon] as [number,number])];
    const lats = allPts.map(p=>p[0]), lons = allPts.map(p=>p[1]);
    mapInstance.fitBounds([[Math.min(...lats)-1,Math.min(...lons)-1],[Math.max(...lats)+1,Math.max(...lons)+1]]);
  }
}

// ── Prediction ────────────────────────────────────
(window as any).runPrediction = async function() {
  const invalid = observations.filter(p => p.LAT===0 && p.LON===0);
  if (invalid.length > 0) {
    alert('⚠️ Semua titik LAT dan LON harus diisi (tidak boleh 0,0).');
    return;
  }
  const steps = parseInt((document.getElementById('horizon-select') as HTMLSelectElement).value);
  const startTime = getStartDateTime().toISOString();

  document.getElementById('pred-spinner')!.style.display='block';
  document.getElementById('results-panel')!.style.display='none';
  document.getElementById('btn-predict')!.setAttribute('disabled','');

  try {
    const res = await fetch('/api/predict', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ observations, startTime, steps })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error||'Gagal prediksi');
    predResults = data.predictions;
    renderResults();
    renderMap();
    document.getElementById('btn-print')!.removeAttribute('disabled');
  } catch(e:any) {
    alert(`⚠️ Terjadi kesalahan: ${e.message}`);
  } finally {
    document.getElementById('pred-spinner')!.style.display='none';
    document.getElementById('btn-predict')!.removeAttribute('disabled');
  }
};

function renderResults() {
  const panel = document.getElementById('results-panel')!;
  panel.style.display='block';
  const lastObs = observations[observations.length-1];
  let prevLat = lastObs.LAT, prevLon = lastObs.LON;

  const html = predResults.map((r,i) => {
    const step = i+1;
    const dist = haversine(prevLat, prevLon, r.pred_lat, r.pred_lon);
    const speed = (dist/3).toFixed(1);
    const brng = bearing(prevLat, prevLon, r.pred_lat, r.pred_lon).toFixed(1);
    const cat = getCategory(lastObs.WMO_WIND);
    const rel = getReliability(step);
    prevLat = r.pred_lat; prevLon = r.pred_lon;
    const ts = new Date(r.time).toLocaleString('id-ID',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
    return `
      <div style="border:1px solid #E5E7EB;border-radius:10px;padding:14px;margin-bottom:10px;background:#FAFAFA;">
        <div style="font-weight:800;font-size:0.88rem;color:#1E3A8A;margin-bottom:8px;">Step ${step} — ${ts}</div>
        <div class="grid-3" style="gap:8px;">
          <div style="background:white;border:1px solid #E5E7EB;border-radius:8px;padding:10px;text-align:center;">
            <div style="font-size:10px;font-weight:700;color:#6B7280;text-transform:uppercase;margin-bottom:4px;">Lintang</div>
            <div style="font-size:1.1rem;font-weight:900;color:#1E3A8A;">${formatLat(r.pred_lat)}</div>
          </div>
          <div style="background:white;border:1px solid #E5E7EB;border-radius:8px;padding:10px;text-align:center;">
            <div style="font-size:10px;font-weight:700;color:#6B7280;text-transform:uppercase;margin-bottom:4px;">Bujur</div>
            <div style="font-size:1.1rem;font-weight:900;color:#1E3A8A;">${formatLon(r.pred_lon)}</div>
          </div>
          <div style="background:white;border:1px solid #E5E7EB;border-radius:8px;padding:10px;text-align:center;">
            <div style="font-size:10px;font-weight:700;color:#6B7280;text-transform:uppercase;margin-bottom:4px;">Kecepatan</div>
            <div style="font-size:1.1rem;font-weight:900;color:#1E3A8A;">${speed} km/h</div>
          </div>
        </div>
        <div style="margin-top:8px;font-size:0.8rem;color:#4B5563;display:flex;flex-wrap:wrap;gap:8px;">
          <span>📦 <b>${cat}</b></span>
          <span>🧭 Arah: <b>${brng}°</b></span>
          <span>🎯 Reliabilitas: <b style="color:${rel.color};">${rel.text}</b> (${rel.km})</span>
        </div>
      </div>`;
  }).join('');
  document.getElementById('results-content')!.innerHTML = html;
}

// ── Reset ─────────────────────────────────────────
(window as any).resetAll = function() {
  observations.forEach(p => { p.LAT=0; p.LON=0; p.WMO_WIND=115; p.WMO_PRES=1005; });
  predResults = [];
  document.getElementById('results-panel')!.style.display='none';
  document.getElementById('btn-print')!.setAttribute('disabled','');
  loadPoint(0);
  renderObsTable();
  renderMap();
};

// ── Print Laporan (PDF Apple-to-Apple) ──────────────
(window as any).printReport = async function() {
  if (!predResults || predResults.length === 0) {
    alert('Jalankan prediksi LSTM terlebih dahulu sebelum mencetak laporan.');
    return;
  }
  const btn = document.getElementById('btn-print') as HTMLButtonElement;
  const origText = btn.innerHTML;
  btn.innerHTML = '⏳ Menyiapkan Preview PDF...';
  btn.disabled = true;

  try {
    const startDt = getStartDateTime();
    const steps = parseInt((document.getElementById('horizon-select') as HTMLSelectElement).value);
    const horizonHours = steps * 3;
    await generateAndDownloadPdfReport(observations, predResults, startDt, horizonHours, steps);
  } catch (err: any) {
    console.error(err);
    alert(`Gagal membuat PDF: ${err.message || err}`);
  } finally {
    btn.innerHTML = origText;
    btn.disabled = false;
  }
};

// ── Init ──────────────────────────────────────────
const today = new Date().toISOString().split('T')[0];
(document.getElementById('inp-date') as HTMLInputElement).value = today;
document.getElementById('inp-date')!.addEventListener('change', renderObsTable);
document.getElementById('inp-time')!.addEventListener('change', renderObsTable);
document.getElementById('point-select')!.addEventListener('change', () =>
  loadPoint(parseInt((document.getElementById('point-select') as HTMLSelectElement).value))
);

initPointSelect();
renderObsTable();
renderMap().catch(console.error);
</script>

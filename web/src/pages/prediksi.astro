---
import Layout from '../layouts/Layout.astro';
---
<Layout title="War Room Prediksi Siklon">
  <div class="fade-in">
    
    <!-- Header Command Center -->
    <div class="war-room-header">
      <div>
        <div class="war-room-badge">
          <span class="live-pulse"></span>
          <span>SPATIAL-TEMPORAL AI WAR ROOM</span>
        </div>
        <h2 class="war-room-title">🔮 Simulasi & Prediksi Lintasan Siklon (LSTM)</h2>
        <p class="war-room-subtitle">
          Pusat komputasi peramalan trajektori siklon di Samudra Hindia dengan pemodelan kerucut ketidakpastian (<em>Cone of Uncertainty</em>) dan mitigasi risiko pesisir Sumatera Barat.
        </p>
      </div>
      <div class="war-room-stats">
        <div class="stat-pill"><span class="stat-lbl">Model</span><strong>LSTM 64 GAB-8</strong></div>
        <div class="stat-pill"><span class="stat-lbl">Interval</span><strong>3 Jam / Step</strong></div>
        <div class="stat-pill"><span class="stat-lbl">Engine</span><strong>ONNX Serverless</strong></div>
      </div>
    </div>

    <!-- 1-Click Quick Preset Scenarios Bar -->
    <div class="preset-bar-card">
      <div class="preset-bar-title">
        <span>🚀 1-Click Skenario Demo Instan:</span>
      </div>
      <div class="preset-buttons">
        <button type="button" class="btn-preset preset-danger" onclick="loadPreset('padang_near')">
          <span class="p-icon">⚠️</span>
          <span><strong>Skenario A:</strong> Mendekati Padang (&lt;400 km)</span>
        </button>
        <button type="button" class="btn-preset preset-warning" onclick="loadPreset('cempaka')">
          <span class="p-icon">🌀</span>
          <span><strong>Skenario B:</strong> Siklon Cempaka (Historis)</span>
        </button>
        <button type="button" class="btn-preset preset-danger" onclick="loadPreset('extreme')">
          <span class="p-icon">🌪️</span>
          <span><strong>Skenario C:</strong> Super Cyclone (115 Kt)</span>
        </button>
        <button type="button" class="btn-preset preset-neutral" onclick="loadPreset('moving_away')">
          <span class="p-icon">🌊</span>
          <span><strong>Skenario D:</strong> Menjauhi Pesisir</span>
        </button>
      </div>
    </div>
        <div class="split-layout" style="align-items:start;">
      
      <!-- ===== KIRI: KONFIGURASI & EDITOR OBSERVASI ===== -->
      <div class="left-command-col">
        
        <!-- CARD 1: KONFIGURASI HORIZON & WAKTU AWAL (DITAMPILKAN LEBIH DULU) -->
        <div class="page-panel horizon-panel">
          <div class="page-section-header">
            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px;">
              <h2 class="section-title">⚙️ Konfigurasi Horizon & Waktu Awal</h2>
              <span class="badge badge-success">Langkah 1</span>
            </div>
            <p class="section-subtitle">Tentukan target proyeksi waktu peramalan dan waktu awal siklus observasi (WIB).</p>
          </div>

          <div class="form-group" style="margin-bottom:12px;">
            <label class="form-label" for="horizon-select">Horizon Peramalan (Jam ke Depan):</label>
            <select id="horizon-select" class="form-select horizon-select-styled">
              <option value="1">⚡ 3 Jam (1 Langkah - Akurasi Tertinggi ~92%)</option>
              <option value="2">⏳ 6 Jam (2 Langkah - Sedang ~78%)</option>
              <option value="3" selected>🌀 9 Jam (3 Langkah - Multi-Step Rekursif ~61%)</option>
            </select>
          </div>

          <div class="grid-2" style="gap:10px;">
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label" for="inp-date">Tanggal Awal (Titik 1)</label>
              <input type="date" id="inp-date" class="form-input" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label" for="inp-time">Jam Awal (WIB)</label>
              <input type="time" id="inp-time" class="form-input" value="00:00" />
            </div>
          </div>
        </div>

        <!-- CARD 2: EDITOR DATA OBSERVASI (8 TITIK) -->
        <div class="page-panel obs-panel">
          <div class="page-section-header">
            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px;">
              <h2 class="section-title">📝 Editor Data Observasi (8 Titik)</h2>
              <span class="badge badge-warning">Langkah 2</span>
            </div>
            <p class="section-subtitle">Input 8 koordinat berurutan (interval 3 jam) atau ketuk langsung di peta.</p>
          </div>

          <!-- Point Selector -->
          <div class="form-group" style="margin-bottom:10px;">
            <label class="form-label" for="point-select">Pilih Nomor Titik untuk Diedit:</label>
            <select id="point-select" class="form-select"></select>
          </div>

          <!-- Point Editor Form -->
          <div id="point-editor" class="grid-2" style="gap:10px; margin-bottom:10px;">
            <div>
              <div class="form-group" style="margin-bottom:8px;">
                <label class="form-label" for="inp-lat">Latitude (°)</label>
                <input type="number" id="inp-lat" class="form-input" step="0.01" value="0" />
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label class="form-label" for="inp-wind">WMO Wind (knot)</label>
                <input type="number" id="inp-wind" class="form-input" step="1" value="115" />
              </div>
            </div>
            <div>
              <div class="form-group" style="margin-bottom:8px;">
                <label class="form-label" for="inp-lon">Longitude (°)</label>
                <input type="number" id="inp-lon" class="form-input" step="0.01" value="0" />
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label class="form-label" for="inp-pres">WMO Pressure (hPa)</label>
                <input type="number" id="inp-pres" class="form-input" step="1" value="1005" />
              </div>
            </div>
          </div>

          <button type="button" class="btn btn-secondary btn-full" onclick="savePoint()" style="margin-bottom:12px;">
            💾 Simpan Titik Ini ke Tabel
          </button>

          <div class="divider" style="margin:12px 0;"></div>

          <!-- Observation Table -->
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <span style="font-weight:800; font-size:0.84rem; color:#1E3A8A;">📋 Tabel 8 Titik Observasi</span>
            <span style="font-size:0.72rem; color:#64748B; font-weight:600;">Klik baris untuk edit</span>
          </div>
          <div class="custom-table-wrapper" id="obs-table-wrapper"></div>
          
          <div class="page-notice" style="margin-top:10px; margin-bottom:0;">
            💡 <strong>Tip Interaktif:</strong> Anda dapat mengetuk / mengklik sembarang lokasi di peta untuk langsung mengisi koordinat titik aktif.
          </div>
        </div>

        <!-- Action Buttons (Responsive Layout) -->
        <div class="pred-actions-grid" style="margin-top:12px; margin-bottom:16px;">
          <button type="button" class="btn btn-primary btn-predict-main" id="btn-predict" onclick="runPrediction()">
            🧠 Jalankan Prediksi LSTM
          </button>
          <div class="pred-sub-actions">
            <button type="button" class="btn btn-secondary" id="btn-print" disabled onclick="printReport()" style="flex:1;">
              📄 Print PDF
            </button>
            <button type="button" class="btn btn-danger" onclick="resetAll()" style="flex:1;">
              🗑️ Reset Data
            </button>
          </div>
        </div>
      </div>

      <!-- ===== KANAN: WAR ROOM PETA & MATRIKS ANCAMAN ===== -->
      <div class="right-display-col">
        <!-- War Room Map Container -->
        <div class="page-panel map-panel-card" style="padding:0; overflow:hidden; margin-bottom:14px; position:relative;">
          <div class="map-toolbar">
            <span style="font-weight:800; font-size:0.86rem; color:#1E3A8A; display:flex; align-items:center; gap:6px;">
              <span>🗺️ Geospatial War Room Map</span>
            </span>
            <!-- Map Layer Switcher -->
            <div class="map-layer-selector">
              <label class="layer-opt"><input type="radio" name="map-layer" value="osm" onchange="switchMapLayer('osm')"> Standar</label>
              <label class="layer-opt"><input type="radio" name="map-layer" value="satellite" checked onchange="switchMapLayer('satellite')"> 🛰️ Satelit</label>
              <label class="layer-opt"><input type="radio" name="map-layer" value="dark" onchange="switchMapLayer('dark')"> 🌙 Gelap</label>
            </div>
          </div>
          
          <div id="pred-map" class="map-container" style="height:clamp(340px, 50vh, 540px);"></div>
          
          <!-- Map Real-time Coordinate HUD Bar -->
          <div id="map-coord-hud" class="map-coord-hud">
            <span class="hud-dot"></span>
            <span id="map-hud-text">📍 Arahkan kursor atau klik di peta untuk inspeksi koordinat</span>
          </div>

          <!-- Interactive Map Toast Notification -->
          <div id="map-toast" class="map-toast" style="display:none;"></div>
        </div>

        <!-- Threat Level Matrix & Advisory (Real-Time Disaster Mitigation) -->
        <div id="threat-matrix-panel" class="threat-panel" style="display:none;">
          <div class="threat-header">
            <div>
              <span class="threat-tag">MATRIKS TINGKAT ANCAMAN & PERINGATAN DINI</span>
              <h3 class="threat-title" id="threat-level-title">LEVEL SIAGA: WASPADA</h3>
            </div>
            <div class="threat-badge-icon" id="threat-icon">⚠️</div>
          </div>

          <div class="threat-metrics-grid">
            <div class="threat-metric-box">
              <span class="tm-label">Jarak Terdekat Pantai</span>
              <span class="tm-val" id="threat-dist">-- km</span>
              <span class="tm-sub" id="threat-closest-city">Pantai Padang</span>
            </div>
            <div class="threat-metric-box">
              <span class="tm-label">Kategori Intensitas</span>
              <span class="tm-val" id="threat-category">Depresi Tropis</span>
              <span class="tm-sub" id="threat-wind">-- knot</span>
            </div>
            <div class="threat-metric-box">
              <span class="tm-label">Arah & Kecepatan</span>
              <span class="tm-val" id="threat-speed">-- km/h</span>
              <span class="tm-sub" id="threat-bearing">Arah --°</span>
            </div>
          </div>

          <div class="threat-advisory" id="threat-advisory-text">
            Memuat analisis dampak pesisir...
          </div>
        </div>

        <!-- Prediction Step Results -->
        <div id="results-panel" class="page-panel" style="display:none; margin-top:16px;">
          <div class="page-section-header">
            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
              <h2 class="section-title">📍 Rincian Koordinat Proyeksi Per Langkah (Horizon 3–9 Jam)</h2>
              <span class="badge badge-success" id="pred-badge-summary">3 Langkah Rekursif</span>
            </div>
            <p class="section-subtitle">Hasil inferensi rekursif model LSTM beserta kerucut ketidakpastian spasial (<em>Spatial Uncertainty Cone</em>).</p>
          </div>
          
          <div id="results-content" class="results-cards-container"></div>
          
          <div class="page-notice" style="background:#FEF2F2; border-color:#FCA5A5; color:#991B1B; margin-top:16px;">
            <strong>⚠️ Catatan Ilmiah:</strong> Prediksi ini bersifat <em>data-driven</em>. Peningkatan horizon waktu (6–9 jam) secara inheren meningkatkan akumulasi ketidakpastian (kerucut ketidakpastian membesar). Rekomendasikan verifikasi silang dengan buletin BMKG.
          </div>
        </div>

        <!-- Spinner -->
        <div id="pred-spinner" style="display:none; text-align:center; padding:28px 20px;">
          <div class="spinner" style="width:36px;height:36px;margin:0 auto 12px;"></div>
          <p style="color:#1E3A8A; font-weight:800; margin:0; font-size:0.95rem;">⏳ Menjalankan Inferensi Rekursif Model LSTM (ONNX)...</p>
          <p style="color:#64748B; font-size:0.82rem; margin:6px 0 0;">Mengekstrak 8 fitur geometri & menghitung kerucut ketidakpastian spasial</p>
        </div>
      </div>

    </div>
  </div>
</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
import { generateAndDownloadPdfReport } from '../lib/pdfReport';

const WINDOW_SIZE = 8;


// Landmark Pesisir Sumatera Barat
const PESISIR_SUMBAR = [
  { lat: -0.95, lon: 100.35, name: 'Kota Padang' },
  { lat: -1.35, lon: 100.55, name: 'Painan (Pesisir Selatan)' },
  { lat: -0.30, lon: 99.80,  name: 'Kota Pariaman' },
  { lat: 0.30,  lon: 99.10,  name: 'Pasaman Barat' },
];

// Presets untuk Demo Cepat (1-Click)
const PRESETS: Record<string, { name: string; obs: Array<{LAT:number; LON:number; WMO_WIND:number; WMO_PRES:number}> }> = {
  padang_near: {
    name: 'Siklon Mendekat Padang (<400 km)',
    obs: [
      { LAT: -5.5, LON: 96.0, WMO_WIND: 75,  WMO_PRES: 985 },
      { LAT: -4.8, LON: 96.6, WMO_WIND: 80,  WMO_PRES: 980 },
      { LAT: -4.1, LON: 97.2, WMO_WIND: 85,  WMO_PRES: 975 },
      { LAT: -3.4, LON: 97.9, WMO_WIND: 90,  WMO_PRES: 970 },
      { LAT: -2.8, LON: 98.5, WMO_WIND: 95,  WMO_PRES: 965 },
      { LAT: -2.2, LON: 99.1, WMO_WIND: 100, WMO_PRES: 960 },
      { LAT: -1.6, LON: 99.6, WMO_WIND: 105, WMO_PRES: 955 },
      { LAT: -1.1, LON: 100.0, WMO_WIND: 110, WMO_PRES: 950 },
    ]
  },
  cempaka: {
    name: 'Siklon Tropis Cempaka (Historis)',
    obs: [
      { LAT: -8.5, LON: 110.0, WMO_WIND: 35, WMO_PRES: 1000 },
      { LAT: -8.6, LON: 110.4, WMO_WIND: 40, WMO_PRES: 998 },
      { LAT: -8.7, LON: 110.8, WMO_WIND: 45, WMO_PRES: 996 },
      { LAT: -8.8, LON: 111.1, WMO_WIND: 45, WMO_PRES: 996 },
      { LAT: -8.9, LON: 111.3, WMO_WIND: 45, WMO_PRES: 996 },
      { LAT: -9.0, LON: 111.4, WMO_WIND: 40, WMO_PRES: 998 },
      { LAT: -9.2, LON: 111.3, WMO_WIND: 35, WMO_PRES: 1000 },
      { LAT: -9.4, LON: 111.1, WMO_WIND: 30, WMO_PRES: 1002 },
    ]
  },
  extreme: {
    name: 'Super Cyclone (Kat. 4 - 115 Knot)',
    obs: [
      { LAT: -12.0, LON: 92.0, WMO_WIND: 85,  WMO_PRES: 970 },
      { LAT: -11.2, LON: 92.8, WMO_WIND: 90,  WMO_PRES: 965 },
      { LAT: -10.3, LON: 93.5, WMO_WIND: 95,  WMO_PRES: 960 },
      { LAT: -9.5,  LON: 94.2, WMO_WIND: 100, WMO_PRES: 955 },
      { LAT: -8.6,  LON: 95.0, WMO_WIND: 105, WMO_PRES: 950 },
      { LAT: -7.7,  LON: 95.8, WMO_WIND: 110, WMO_PRES: 945 },
      { LAT: -6.8,  LON: 96.5, WMO_WIND: 115, WMO_PRES: 940 },
      { LAT: -5.9,  LON: 97.2, WMO_WIND: 115, WMO_PRES: 940 },
    ]
  },
  moving_away: {
    name: 'Siklon Bergerak Menjauhi Pesisir',
    obs: [
      { LAT: -2.0, LON: 98.0, WMO_WIND: 65, WMO_PRES: 990 },
      { LAT: -3.1, LON: 97.0, WMO_WIND: 70, WMO_PRES: 985 },
      { LAT: -4.2, LON: 96.0, WMO_WIND: 75, WMO_PRES: 980 },
      { LAT: -5.4, LON: 95.0, WMO_WIND: 80, WMO_PRES: 975 },
      { LAT: -6.5, LON: 94.0, WMO_WIND: 85, WMO_PRES: 970 },
      { LAT: -7.6, LON: 93.0, WMO_WIND: 90, WMO_PRES: 965 },
      { LAT: -8.8, LON: 92.0, WMO_WIND: 95, WMO_PRES: 960 },
      { LAT: -10.0, LON: 91.0, WMO_WIND: 100, WMO_PRES: 955 },
    ]
  }
};

// State
const observations = Array.from({length: WINDOW_SIZE}, () => ({
  LAT: 0, LON: 0, WMO_WIND: 115, WMO_PRES: 1005
}));
let predResults: Array<{pred_lat:number; pred_lon:number; time:string}> = [];
let mapInstance: any = null;
let currentTileLayer: any = null;
let toastTimeout: any = null;

// Tile Layer URLs
const TILES: Record<string, { url: string; attr: string }> = {
  osm: {
    url: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
    attr: '© OpenStreetMap contributors'
  },
  satellite: {
    url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    attr: 'Tiles © Esri — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community'
  },
  dark: {
    url: 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
    attr: '© OpenStreetMap © CARTO'
  }
};

// ── Helpers ───────────────────────────────────────
function haversine(lat1:number,lon1:number,lat2:number,lon2:number):number {
  const R=6371,dLat=(lat2-lat1)*Math.PI/180,dLon=(lon2-lon1)*Math.PI/180;
  const a=Math.sin(dLat/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
  return R*2*Math.asin(Math.sqrt(a));
}
function bearing(lat1:number,lon1:number,lat2:number,lon2:number):number {
  const dLon=(lon2-lon1)*Math.PI/180,φ1=lat1*Math.PI/180,φ2=lat2*Math.PI/180;
  return ((Math.atan2(Math.sin(dLon)*Math.cos(φ2),Math.cos(φ1)*Math.sin(φ2)-Math.sin(φ1)*Math.cos(φ2)*Math.cos(dLon))*180/Math.PI)+360)%360;
}
function formatLat(v:number):string { return `${Math.abs(v).toFixed(2)}° ${v<0?'LS':'LU'}`; }
function formatLon(v:number):string { return `${Math.abs(v).toFixed(2)}° ${v<0?'BB':'BT'}`; }

function getCategory(wind:number):string {
  if(wind>=137) return 'Siklon Tropis Kategori 5 (Super Cyclone)';
  if(wind>=113) return 'Siklon Tropis Kategori 4 (Sangat Kuat)';
  if(wind>=96)  return 'Siklon Tropis Kategori 3 (Kuat)';
  if(wind>=83)  return 'Siklon Tropis Kategori 2 (Sedang)';
  if(wind>=64)  return 'Siklon Tropis Kategori 1 (Minimal)';
  if(wind>=34)  return 'Badai Tropis (Tropical Storm)';
  return 'Depresi Tropis (Tropical Depression)';
}

function getReliability(step: number) {
  if (step === 1) return {
    text: 'Akurasi Tinggi (~92%)',
    level: 'Tinggi',
    color: '#059669',
    badgeBg: '#D1FAE5',
    badgeBorder: '#059669',
    cardBorder: '#10B981',
    km: '±20 km cone',
    coneDesc: 'Radius Kerucut Spasial ±20 km',
    icon: '🟢'
  };
  if (step === 2) return {
    text: 'Akurasi Sedang (~78%)',
    level: 'Sedang',
    color: '#D97706',
    badgeBg: '#FEF3C7',
    badgeBorder: '#D97706',
    cardBorder: '#F59E0B',
    km: '±45 km cone',
    coneDesc: 'Radius Kerucut Spasial ±45 km',
    icon: '🟡'
  };
  return {
    text: 'Akurasi Multi-Step (~61%)',
    level: 'Rendah',
    color: '#DC2626',
    badgeBg: '#FEE2E2',
    badgeBorder: '#DC2626',
    cardBorder: '#EF4444',
    km: '±75 km cone',
    coneDesc: 'Radius Kerucut Spasial ±75 km',
    icon: '🔴'
  };
}

function bearingToCompassIndo(deg: number): string {
  const directions = [
    'Utara (U)', 'Timur Laut (TL)', 'Timur (T)', 'Tenggara (TG)',
    'Selatan (S)', 'Barat Daya (BD)', 'Barat (B)', 'Barat Laut (BL)',
  ];
  const idx = Math.round(deg / 45) % 8;
  return directions[idx];
}

function showMapToast(msg: string) {
  const toast = document.getElementById('map-toast');
  if (!toast) return;
  toast.innerHTML = msg;
  toast.style.display = 'block';
  toast.classList.add('toast-show');
  if (toastTimeout) clearTimeout(toastTimeout);
  toastTimeout = setTimeout(() => {
    toast.classList.remove('toast-show');
    setTimeout(() => { toast.style.display = 'none'; }, 300);
  }, 2400);
}

// ── Point selector ────────────────────────────────
function initPointSelect() {
  const sel = document.getElementById('point-select') as HTMLSelectElement;
  sel.innerHTML = Array.from({length:WINDOW_SIZE},(_,i)=>`<option value="${i}">Titik ${i+1} (Waktu T+${i*3}j)</option>`).join('');
  sel.addEventListener('change', () => {
    loadPoint(parseInt(sel.value));
    renderObsTable();
  });
  loadPoint(0);
}

function loadPoint(idx:number) {
  const p = observations[idx];
  (document.getElementById('inp-lat') as HTMLInputElement).value = p.LAT.toString();
  (document.getElementById('inp-lon') as HTMLInputElement).value = p.LON.toString();
  (document.getElementById('inp-wind') as HTMLInputElement).value = p.WMO_WIND.toString();
  (document.getElementById('inp-pres') as HTMLInputElement).value = p.WMO_PRES.toString();
}

(window as any).selectPointFromTable = function(idx: number) {
  const sel = document.getElementById('point-select') as HTMLSelectElement;
  if (sel) {
    sel.value = idx.toString();
    loadPoint(idx);
    renderObsTable();
    showMapToast(`✏️ Mengedit Titik ${idx + 1}`);
  }
};

(window as any).savePoint = function() {
  const idx = parseInt((document.getElementById('point-select') as HTMLSelectElement).value);
  const lat = parseFloat((document.getElementById('inp-lat') as HTMLInputElement).value)||0;
  const lon = parseFloat((document.getElementById('inp-lon') as HTMLInputElement).value)||0;
  observations[idx].LAT = lat;
  observations[idx].LON = lon;
  observations[idx].WMO_WIND = parseFloat((document.getElementById('inp-wind') as HTMLInputElement).value)||115;
  observations[idx].WMO_PRES = parseFloat((document.getElementById('inp-pres') as HTMLInputElement).value)||1005;
  renderObsTable();
  renderMap();
  showMapToast(`💾 Titik ${idx + 1} berhasil disimpan: ${formatLat(lat)}, ${formatLon(lon)}`);
};

// ── Load Preset ───────────────────────────────────
(window as any).loadPreset = function(presetKey: string) {
  const p = PRESETS[presetKey];
  if (!p) return;
  p.obs.forEach((pt, i) => {
    observations[i].LAT = pt.LAT;
    observations[i].LON = pt.LON;
    observations[i].WMO_WIND = pt.WMO_WIND;
    observations[i].WMO_PRES = pt.WMO_PRES;
  });
  loadPoint(0);
  (document.getElementById('point-select') as HTMLSelectElement).value = '0';
  renderObsTable();
  renderMap();

  showMapToast(`🚀 Memuat ${p.name}`);

  // Pulse predict button
  const predBtn = document.getElementById('btn-predict');
  predBtn?.classList.add('pulse-anim');
  setTimeout(() => predBtn?.classList.remove('pulse-anim'), 1500);
};

// ── Observation Table ─────────────────────────────
function getStartDateTime():Date {
  const d=(document.getElementById('inp-date') as HTMLInputElement).value;
  const t=(document.getElementById('inp-time') as HTMLInputElement).value||'00:00';
  return d ? new Date(`${d}T${t}:00`) : new Date();
}

function renderObsTable() {
  const start = getStartDateTime();
  const currentSelected = parseInt((document.getElementById('point-select') as HTMLSelectElement)?.value || '0');
  
  const rows = observations.map((p,i) => {
    const ts = new Date(start.getTime() + i*3*3600*1000);
    const timeStr = ts.toLocaleString('id-ID',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
    const latStr = p.LAT===0?'<span style="color:#9CA3AF;">0.0°</span>':`<strong>${formatLat(p.LAT)}</strong>`;
    const lonStr = p.LON===0?'<span style="color:#9CA3AF;">0.0°</span>':`<strong>${formatLon(p.LON)}</strong>`;
    const isActive = i === currentSelected;
    
    return `<tr class="${isActive ? 'active-obs-row' : ''}" onclick="selectPointFromTable(${i})" style="cursor:pointer;" title="Klik untuk edit titik ini">
      <td><span class="table-point-badge ${isActive ? 'tpb-active' : ''}">${i+1}</span></td>
      <td>${timeStr}</td>
      <td>${latStr}</td>
      <td>${lonStr}</td>
      <td>${p.WMO_WIND.toFixed(0)}</td>
      <td>${p.WMO_PRES.toFixed(0)}</td>
    </tr>`;
  }).join('');

  document.getElementById('obs-table-wrapper')!.innerHTML = `
    <table class="custom-table" style="font-size:12px;">
      <thead><tr><th>#</th><th>Waktu (WIB)</th><th>Lintang</th><th>Bujur</th><th>Angin (kt)</th><th>Tekanan (hPa)</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
}

// ── Map & Tile Switching ──────────────────────────
let leafletScriptPromise: Promise<any> | null = null;
async function loadLeaflet() {
  if ((window as any).L) return (window as any).L;
  if (!leafletScriptPromise) {
    leafletScriptPromise = new Promise<any>((resolve) => {
      const s = document.createElement('script');
      s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      s.onload = () => resolve((window as any).L);
      document.head.appendChild(s);
    });
  }
  return leafletScriptPromise;
}

(window as any).switchMapLayer = function(layerKey: string) {
  if (!mapInstance) return;
  const L = (window as any).L;
  if (currentTileLayer) mapInstance.removeLayer(currentTileLayer);
  const conf = TILES[layerKey] || TILES.satellite;
  currentTileLayer = L.tileLayer(conf.url, { attribution: conf.attr, maxZoom: 18 }).addTo(mapInstance);
};

let mapLayers: any[] = [];
function clearMapLayers() {
  if (!mapInstance) return;
  mapLayers.forEach(l => {
    try { mapInstance.removeLayer(l); } catch(e) {}
  });
  mapLayers = [];
}
function addLayer(l:any) {
  if (mapInstance) { l.addTo(mapInstance); mapLayers.push(l); }
}

let mapInitPromise: Promise<any> | null = null;
async function ensureMapReady(): Promise<any> {
  const L = await loadLeaflet();
  if (mapInstance) return { L, map: mapInstance };
  if (mapInitPromise) return mapInitPromise;

  mapInitPromise = (async () => {
    const mapEl = document.getElementById('pred-map');
    if (!mapEl) return null;

    // Prevent duplicate initialization on same container
    if ((mapEl as any)._leaflet_id) {
      return { L, map: mapInstance };
    }

    mapInstance = L.map('pred-map', { 
      center: [-1.5, 99.5], 
      zoom: 6, 
      zoomControl: true,
      tap: false,
      preferCanvas: true
    });
    
    // Default Satellite Layer
    const conf = TILES.satellite;
    currentTileLayer = L.tileLayer(conf.url, { attribution: conf.attr, maxZoom: 18 }).addTo(mapInstance);

    // Resize listener to prevent broken tiles
    window.addEventListener('resize', () => {
      if (mapInstance) mapInstance.invalidateSize();
    }, { passive: true });

    // Real-time Coordinate HUD on Mouse Move
    mapInstance.on('mousemove', (e: any) => {
      const hud = document.getElementById('map-hud-text');
      if (hud) {
        hud.innerHTML = `<strong>Kursor Peta:</strong> ${formatLat(e.latlng.lat)}, ${formatLon(e.latlng.lng)} <span style="opacity:0.75; font-size:11px;">(${e.latlng.lat >= 0 ? '+' : ''}${e.latlng.lat.toFixed(3)}°, ${e.latlng.lng >= 0 ? '+' : ''}${e.latlng.lng.toFixed(3)}°)</span>`;
      }
    });

    // Interactive Map Click / Mobile Tap Handler
    mapInstance.on('click', (e: any) => {
      const lat = Math.round(e.latlng.lat * 100) / 100;
      const lon = Math.round(e.latlng.lng * 100) / 100;
      
      const pointSel = document.getElementById('point-select') as HTMLSelectElement;
      let targetIdx = parseInt(pointSel?.value || '0');
      
      const firstEmpty = observations.findIndex(p => p.LAT === 0 && p.LON === 0);
      if (firstEmpty >= 0 && observations[targetIdx].LAT !== 0 && observations[targetIdx].LON !== 0) {
        targetIdx = firstEmpty;
        if (pointSel) pointSel.value = targetIdx.toString();
      }

      observations[targetIdx].LAT = lat;
      observations[targetIdx].LON = lon;
      
      loadPoint(targetIdx);
      renderObsTable();
      renderMap();

      showMapToast(`📍 Titik ${targetIdx + 1} diperbarui: <strong>${formatLat(lat)}, ${formatLon(lon)}</strong>`);

      const hud = document.getElementById('map-hud-text');
      if (hud) {
        hud.innerHTML = `<strong>Titik ${targetIdx + 1} Disetel:</strong> ${formatLat(lat)}, ${formatLon(lon)}`;
      }

      if (targetIdx < WINDOW_SIZE - 1 && observations[targetIdx + 1].LAT === 0) {
        setTimeout(() => {
          if (pointSel) {
            pointSel.value = (targetIdx + 1).toString();
            loadPoint(targetIdx + 1);
            renderObsTable();
          }
        }, 300);
      }
    });

    setTimeout(() => {
      if (mapInstance) mapInstance.invalidateSize();
    }, 200);

    return { L, map: mapInstance };
  })();

  return mapInitPromise;
}

async function renderMap() {
  const ready = await ensureMapReady();
  if (!ready || !mapInstance) return;
  const L = ready.L;

  clearMapLayers();

  // 1. Draw Coastline Warning Buffers (500 km & 1000 km dari Padang) with High Contrast
  const padangPt: [number,number] = [-0.95, 100.35];
  addLayer(L.circle(padangPt, { 
    radius: 500000, 
    color: '#EF4444', 
    weight: 2, 
    fillColor: '#EF4444', 
    fillOpacity: 0.06, 
    dashArray: '6, 6' 
  }).bindTooltip('🚨 Zona Bahaya Utama Pesisir (500 km dari Padang)', { className: 'map-contrast-tooltip' }));

  addLayer(L.circle(padangPt, { 
    radius: 1000000, 
    color: '#F59E0B', 
    weight: 1.5, 
    fillColor: '#F59E0B', 
    fillOpacity: 0.04, 
    dashArray: '5, 5' 
  }).bindTooltip('⚠️ Zona Siaga / Pantauan (1000 km dari Padang)', { className: 'map-contrast-tooltip' }));

  // 2. Draw Sumbar Coastal Landmarks with High-Contrast Solid Badges
  PESISIR_SUMBAR.forEach(p => {
    const icon = L.divIcon({
      html: `<div class="coastal-landmark-badge">📍 ${p.name}</div>`,
      className: '', 
      iconSize: [115, 24], 
      iconAnchor: [57, 12]
    });
    addLayer(L.marker([p.lat, p.lon], { icon }).bindTooltip(
      `<strong>Pesisir ${p.name}</strong><br>Koordinat: ${formatLat(p.lat)}, ${formatLon(p.lon)}`,
      { className: 'map-contrast-tooltip' }
    ));
  });

  const valid = observations.filter(p => p.LAT !== 0 || p.LON !== 0);
  const currentSelected = parseInt((document.getElementById('point-select') as HTMLSelectElement)?.value || '0');

  if (valid.length > 0) {
    const pts = valid.map(p => [p.LAT, p.LON] as [number,number]);
    
    // Draw Historical Trajectory with Dual-Stroke (Dark Halo + Vibrant Electric Cyan)
    // Layer 1: Dark Halo Underlay (Guarantees extreme contrast on light OSM and dark Satellite)
    addLayer(L.polyline(pts, { 
      color: '#020617', 
      weight: 7, 
      opacity: 0.92, 
      lineCap: 'round', 
      lineJoin: 'round' 
    }));
    // Layer 2: Core Vibrant Line (Bright Electric Cyan)
    addLayer(L.polyline(pts, { 
      color: '#00E5FF', 
      weight: 3.5, 
      opacity: 1, 
      lineCap: 'round', 
      lineJoin: 'round' 
    }));
    
    // Draw Distinct Numbered Historical Points 1..8 with High Contrast Nodes
    observations.forEach((p, i) => {
      if (p.LAT === 0 && p.LON === 0) return;
      const isSelected = i === currentSelected;
      const isStart = i === 0;
      const isEnd = i === valid.length - 1;
      
      const icon = L.divIcon({
        html: `<div class="obs-marker-node ${isSelected ? 'obs-node-active' : ''} ${isEnd ? 'obs-node-latest' : ''}"><span>${i+1}</span></div>`,
        className: '',
        iconSize: [28, 28],
        iconAnchor: [14, 14]
      });

      const m = L.marker([p.LAT, p.LON], { icon });

      // Permanent high-contrast badge on Start (T1) and Latest (T8) points
      if (isStart || isEnd) {
        m.bindTooltip(
          `<strong>T${i+1}${isEnd ? ' (Terkini)' : ' (Awal)'}:</strong> ${formatLat(p.LAT)}, ${formatLon(p.LON)}`,
          {
            permanent: true,
            direction: 'top',
            offset: [0, -15],
            className: `map-contrast-tooltip ${isEnd ? 'map-tooltip-latest' : 'map-tooltip-start'}`
          }
        );
      } else {
        m.bindTooltip(
          `<strong>Titik ${i+1} (Histori Observasi)</strong><br>Koordinat: <strong>${formatLat(p.LAT)}, ${formatLon(p.LON)}</strong><br>💨 Kec. Angin: ${p.WMO_WIND} knot<br>⏱️ Tekanan: ${p.WMO_PRES} hPa<br><em>(Klik untuk edit titik ini)</em>`,
          { className: 'map-contrast-tooltip' }
        );
      }
      
      m.on('click', (ev: any) => {
        L.DomEvent.stopPropagation(ev);
        (window as any).selectPointFromTable(i);
      });

      addLayer(m);
    });

    // 3. Draw Recursive Predictions + Spatial Cone of Uncertainty + Permanent High-Contrast Labels
    if (predResults && predResults.length > 0) {
      let prevPt = pts[pts.length - 1];
      const uncertaintyRadii = [20000, 45000, 75000]; // Meter radius per step (3h, 6h, 9h)
      const stepColors = ['#10B981', '#F59E0B', '#EF4444'];
      const stepNames = ['+3 Jam', '+6 Jam', '+9 Jam'];

      predResults.forEach((r, i) => {
        const pt: [number,number] = [r.pred_lat, r.pred_lon];
        const radiusM = uncertaintyRadii[i] || 75000;
        const sColor = stepColors[i] || '#EF4444';
        const rel = getReliability(i + 1);

        // Uncertainty Cone Circle with matching step color & crisp outline
        addLayer(L.circle(pt, { 
          radius: radiusM, 
          color: sColor, 
          fillColor: sColor, 
          fillOpacity: 0.18, 
          weight: 2, 
          dashArray: '5, 5' 
        }).bindTooltip(`Kerucut Ketidakpastian Spasial Langkah ${i+1} (${stepNames[i]}): ±${radiusM/1000} km`, { className: 'map-contrast-tooltip' }));

        // Dual-Stroke Dashed Prediction Trajectory (Dark Halo + Neon Crimson Dash)
        // Halo
        addLayer(L.polyline([prevPt, pt], { 
          color: '#020617', 
          weight: 7.5, 
          opacity: 0.92, 
          lineCap: 'round', 
          lineJoin: 'round' 
        }));
        // Core Line
        addLayer(L.polyline([prevPt, pt], { 
          color: '#FF2D55', 
          weight: 4, 
          dashArray: '8 6', 
          opacity: 1, 
          lineCap: 'round', 
          lineJoin: 'round' 
        }));

        // Pulsing Cyclone Prediction Icon with Step-specific Glowing Marker
        const icon = L.divIcon({
          html: `<div class="cyclone-marker-pulse cyclone-step-${i+1}"><span>P${i+1}</span></div>`,
          className: '', 
          iconSize: [32, 32], 
          iconAnchor: [16, 16]
        });

        const predMarker = L.marker(pt, { icon });
        
        // Permanent High-Contrast Coordinate Badge for Prediction Points
        predMarker.bindTooltip(
          `<strong>P${i+1} (${stepNames[i]}):</strong> ${formatLat(r.pred_lat)}, ${formatLon(r.pred_lon)} <span style="opacity:0.85; font-size:10px;">(${rel.km})</span>`,
          {
            permanent: true,
            direction: 'top',
            offset: [0, -18],
            className: `map-contrast-tooltip map-tooltip-p${i+1}`
          }
        );

        addLayer(predMarker);
        prevPt = pt;
      });
    }

    // Auto fit bounds to show all points
    const allPts = [
      ...pts, 
      ...predResults.map(r => [r.pred_lat, r.pred_lon] as [number,number]),
      ...PESISIR_SUMBAR.map(p => [p.lat, p.lon] as [number,number])
    ];
    const lats = allPts.map(p => p[0]), lons = allPts.map(p => p[1]);
    mapInstance.fitBounds([
      [Math.min(...lats) - 0.6, Math.min(...lons) - 0.6],
      [Math.max(...lats) + 0.6, Math.max(...lons) + 0.6]
    ], { padding: [24, 24] });
  }
}

// ── Prediction ────────────────────────────────────
(window as any).runPrediction = async function() {
  const invalid = observations.filter(p => p.LAT===0 && p.LON===0);
  if (invalid.length > 0) {
    alert('⚠️ Semua 8 titik observasi harus terisi sebelum menjalankan inferensi model LSTM.');
    return;
  }
  const steps = parseInt((document.getElementById('horizon-select') as HTMLSelectElement).value);
  const startTime = getStartDateTime().toISOString();

  document.getElementById('pred-spinner')!.style.display='block';
  document.getElementById('results-panel')!.style.display='none';
  document.getElementById('threat-matrix-panel')!.style.display='none';
  document.getElementById('btn-predict')!.setAttribute('disabled','');

  try {
    const res = await fetch('/api/predict', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ observations, startTime, steps })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error||'Gagal menjalankan inferensi');
    predResults = data.predictions;
    renderResults();
    renderMap();
    document.getElementById('btn-print')!.removeAttribute('disabled');
    showMapToast('✅ Hasil prediksi LSTM berhasil dihitung!');
    
    // Smooth scroll down to results if on mobile
    if (window.innerWidth <= 900) {
      document.getElementById('threat-matrix-panel')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  } catch(e:any) {
    alert(`⚠️ Terjadi kesalahan inferensi: ${e.message}`);
  } finally {
    document.getElementById('pred-spinner')!.style.display='none';
    document.getElementById('btn-predict')!.removeAttribute('disabled');
  }
};

function renderResults() {
  const panel = document.getElementById('results-panel')!;
  const threatPanel = document.getElementById('threat-matrix-panel')!;
  panel.style.display='block';
  threatPanel.style.display='block';

  const lastObs = observations[observations.length-1];
  let prevLat = lastObs.LAT, prevLon = lastObs.LON;

  // Analisis Jarak Terdekat ke Pantai Sumbar
  let minDistance = Infinity;
  let closestCity = 'Kota Padang';
  predResults.forEach(r => {
    PESISIR_SUMBAR.forEach(city => {
      const d = haversine(r.pred_lat, r.pred_lon, city.lat, city.lon);
      if (d < minDistance) {
        minDistance = d;
        closestCity = city.name;
      }
    });
  });

  const step1 = predResults[0];
  const dist1 = haversine(lastObs.LAT, lastObs.LON, step1.pred_lat, step1.pred_lon);
  const speed1 = (dist1 / 3).toFixed(1);
  const brng1 = bearing(lastObs.LAT, lastObs.LON, step1.pred_lat, step1.pred_lon).toFixed(1);
  const catText = getCategory(lastObs.WMO_WIND);

  // Update Threat Matrix Box
  const threatTitle = document.getElementById('threat-level-title')!;
  const threatIcon = document.getElementById('threat-icon')!;
  const threatDist = document.getElementById('threat-dist')!;
  const threatClosestCity = document.getElementById('threat-closest-city')!;
  const threatCat = document.getElementById('threat-category')!;
  const threatWind = document.getElementById('threat-wind')!;
  const threatSpeed = document.getElementById('threat-speed')!;
  const threatBearing = document.getElementById('threat-bearing')!;
  const threatAdv = document.getElementById('threat-advisory-text')!;

  threatDist.textContent = `${minDistance.toFixed(1)} km`;
  threatClosestCity.textContent = `Terdekat dari ${closestCity}`;
  threatCat.textContent = catText.split('(')[0];
  threatWind.textContent = `${lastObs.WMO_WIND} Knot (${(lastObs.WMO_WIND * 1.852).toFixed(0)} km/h)`;
  threatSpeed.textContent = `${speed1} km/h`;
  threatBearing.textContent = `Arah ${brng1}° (${bearingToCompassIndo(parseFloat(brng1))})`;

  if (minDistance < 350) {
    threatTitle.textContent = 'LEVEL SIAGA 1: AWAS & RISIKO KRITIS';
    threatTitle.style.color = '#DC2626';
    threatIcon.textContent = '🚨';
    threatAdv.innerHTML = `<strong>REKOMENDASI DARURAT BPBD / SAR:</strong> Siklon berada dalam radius kritis (&lt;350 km) dari ${closestCity}. Dihimbau larangan berlayar bagi nelayan, evakuasi dini aktivitas di bibir pantai, dan pengamanan logistik terhadap ancaman gelombang pasang ekstrem.`;
  } else if (minDistance < 650) {
    threatTitle.textContent = 'LEVEL SIAGA 2: WASPADA TINGGI';
    threatTitle.style.color = '#D97706';
    threatIcon.textContent = '⚠️';
    threatAdv.innerHTML = `<strong>HIMBAUAN KESIAPSIAGAAN:</strong> Siklon terdeteksi dalam jarak ${minDistance.toFixed(1)} km dari ${closestCity}. Peningkatan kecepatan angin dan gelombang sedang diimbau untuk dipantau secara ketat setiap siklus 3 jam.`;
  } else {
    threatTitle.textContent = 'LEVEL MONITORING: DALAM PENGAWASAN';
    threatTitle.style.color = '#059669';
    threatIcon.textContent = '🛡️';
    threatAdv.innerHTML = `<strong>STATUS AMAN RELATIF:</strong> Lintasan siklon berjarak ${minDistance.toFixed(1)} km dari pesisir ${closestCity}. Tetap pantau evolusi trajektori sistem tekanan rendah ini.`;
  }

  // Update Summary Badge
  const summaryBadge = document.getElementById('pred-badge-summary');
  if (summaryBadge) {
    summaryBadge.textContent = `${predResults.length} Langkah Proyeksi (+${predResults.length * 3} Jam)`;
  }

  // Rincian Step Cards with Dynamic Step Color Themes and Generous Spacing
  const html = predResults.map((r, i) => {
    const step = i + 1;
    const dist = haversine(prevLat, prevLon, r.pred_lat, r.pred_lon);
    const speed = (dist / 3).toFixed(1);
    const brng = bearing(prevLat, prevLon, r.pred_lat, r.pred_lon).toFixed(1);
    const rel = getReliability(step);
    prevLat = r.pred_lat; 
    prevLon = r.pred_lon;
    const ts = new Date(r.time).toLocaleString('id-ID', {
      weekday: 'short',
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
    
    return `
      <div class="result-step-card step-card-${step}">
        <!-- Header -->
        <div class="result-step-header">
          <div class="result-step-title-grp">
            <span class="result-step-badge step-badge-${step}">
              LANGKAH ${step} (+${step * 3} JAM)
            </span>
            <span class="result-step-time">
              <span class="time-icon">🕒</span> Target: <strong>${ts} WIB</strong>
            </span>
          </div>
          <div class="result-step-rel step-rel-${step}">
            <span class="rel-icon">${rel.icon}</span>
            <span class="rel-text"><strong>${rel.text}</strong></span>
            <span class="rel-cone">(${rel.km})</span>
          </div>
        </div>

        <!-- Metrics Grid (Spacious 3-Column Layout) -->
        <div class="result-metrics-grid">
          <div class="res-metric-item">
            <div class="res-metric-lbl">
              <span class="res-icon">🌐</span> Lintang Proyeksi
            </div>
            <div class="res-metric-val">${formatLat(r.pred_lat)}</div>
            <div class="res-metric-sub">${r.pred_lat.toFixed(4)}° (Desimal)</div>
          </div>

          <div class="res-metric-item">
            <div class="res-metric-lbl">
              <span class="res-icon">🧭</span> Bujur Proyeksi
            </div>
            <div class="res-metric-val">${formatLon(r.pred_lon)}</div>
            <div class="res-metric-sub">${r.pred_lon.toFixed(4)}° (Desimal)</div>
          </div>

          <div class="res-metric-item">
            <div class="res-metric-lbl">
              <span class="res-icon">⚡</span> Kecepatan Gerak
            </div>
            <div class="res-metric-val">${speed} <span class="res-unit">km/h</span></div>
            <div class="res-metric-sub">~${(parseFloat(speed) / 1.852).toFixed(1)} Knot</div>
          </div>
        </div>

        <!-- Footer Meta Strip with Clear Badges -->
        <div class="result-step-footer">
          <div class="res-footer-pill">
            <span class="rf-icon">🧭</span>
            <span class="rf-lbl">Arah:</span>
            <span class="rf-val"><strong>${brng}°</strong> (${bearingToCompassIndo(parseFloat(brng))})</span>
          </div>
          <div class="res-footer-pill">
            <span class="rf-icon">📏</span>
            <span class="rf-lbl">Jarak Geser:</span>
            <span class="rf-val"><strong>${dist.toFixed(1)} km</strong> / 3 jam</span>
          </div>
          <div class="res-footer-pill">
            <span class="rf-icon">🎯</span>
            <span class="rf-lbl">Kerucut Spasial:</span>
            <span class="rf-val"><strong style="color:${rel.color};">${rel.coneDesc}</strong></span>
          </div>
        </div>
      </div>`;
  }).join('');
  
  document.getElementById('results-content')!.innerHTML = html;
}

// ── Reset ─────────────────────────────────────────
(window as any).resetAll = function() {
  observations.forEach(p => { p.LAT=0; p.LON=0; p.WMO_WIND=115; p.WMO_PRES=1005; });
  predResults = [];
  document.getElementById('results-panel')!.style.display='none';
  document.getElementById('threat-matrix-panel')!.style.display='none';
  document.getElementById('btn-print')!.setAttribute('disabled','');
  loadPoint(0);
  (document.getElementById('point-select') as HTMLSelectElement).value = '0';
  renderObsTable();
  renderMap();
  showMapToast('🗑️ Data observasi telah di-reset');
};

// ── Print Laporan (PDF Apple-to-Apple) ──────────────
(window as any).printReport = async function() {
  if (!predResults || predResults.length === 0) {
    alert('Jalankan prediksi LSTM terlebih dahulu sebelum mencetak laporan.');
    return;
  }
  const btn = document.getElementById('btn-print') as HTMLButtonElement;
  const origText = btn.innerHTML;
  btn.innerHTML = '⏳ Menyiapkan Preview PDF...';
  btn.disabled = true;

  try {
    const startDt = getStartDateTime();
    const steps = parseInt((document.getElementById('horizon-select') as HTMLSelectElement).value);
    const horizonHours = steps * 3;
    await generateAndDownloadPdfReport(observations, predResults, startDt, horizonHours, steps);
  } catch (err: any) {
    console.error(err);
    alert(`Gagal membuat PDF: ${err.message || err}`);
  } finally {
    btn.innerHTML = origText;
    btn.disabled = false;
  }
};

// ── Init on Load ──────────────────────────────────
const today = new Date().toISOString().split('T')[0];
(document.getElementById('inp-date') as HTMLInputElement).value = today;
document.getElementById('inp-date')!.addEventListener('change', renderObsTable);
document.getElementById('inp-time')!.addEventListener('change', renderObsTable);
document.getElementById('point-select')!.addEventListener('change', () => {
  loadPoint(parseInt((document.getElementById('point-select') as HTMLSelectElement).value));
  renderObsTable();
});

initPointSelect();
renderObsTable();

// Check if preset query parameter exists in URL, otherwise load default Scenario A
const urlParams = new URLSearchParams(window.location.search);
const presetParam = urlParams.get('preset');
if (presetParam && PRESETS[presetParam]) {
  (window as any).loadPreset(presetParam);
} else {
  (window as any).loadPreset('padang_near');
}

</script>


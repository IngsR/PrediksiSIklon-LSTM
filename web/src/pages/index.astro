---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Beranda">
  <div class="fade-in">

    <!-- ===== HERO ===== -->
    <div class="hero-card">
      <div class="hero-content">
        <div class="hero-badge">
          <img src="/logo.jpg" alt="Logo" class="hero-badge-logo" width="16" height="16" />
          <span>Tugas Akhir &bull; Teknik Informatika</span>
        </div>
        <h1 class="hero-title">Prediksi Lintasan Siklon Tropis berbasis LSTM</h1>
        <p class="hero-desc">
          Sistem prediksi berbasis deep learning yang memperkirakan pergerakan siklon di Samudera Hindia 
          dan menganalisis potensi ancaman ke wilayah pesisir Sumatera Barat.
        </p>
        <div class="hero-actions">
          <a href="/prediksi" class="btn btn-primary btn-hero-glow">
            <span>🌀 Coba Prediksi Sekarang</span>
          </a>
          <a href="/dashboard" class="btn btn-hero-secondary">
            <span>🗺️ Dashboard</span>
          </a>
          <a href="/evaluasi" class="btn btn-hero-outline">
            <span>📊 Evaluasi Akurasi</span>
          </a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/assets/banner_beranda.png" alt="Siklon Tropis" class="hero-img" loading="eager"
          onerror="this.style.display='none'; document.getElementById('hero-fallback').style.display='flex';" />
        <div id="hero-fallback" class="hero-fallback" style="display:none;">
          <div style="text-align:center;">
            <div style="font-size:54px; margin-bottom:8px;">🌀</div>
            <p style="color:white; font-weight:800; margin:0; font-size:15px;">Prediksi Siklon Tropis</p>
            <p style="color:#93C5FD; font-size:11px; margin:4px 0 0;">Samudera Hindia · Sumatera Barat</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== RINGKASAN SISTEM ===== -->
    <div class="grid-4" style="margin-bottom: 20px;">
      <div class="info-card-mini">
        <div class="info-mini-header">
          <span class="info-mini-icon">🤖</span>
          <span class="info-mini-label">Model AI</span>
        </div>
        <div class="info-mini-value">LSTM 64 Unit</div>
        <div class="info-mini-sub">ONNX · Inferensi kurang dari 15ms</div>
      </div>
      <div class="info-card-mini">
        <div class="info-mini-header">
          <span class="info-mini-icon">📍</span>
          <span class="info-mini-label">Area Pemantauan</span>
        </div>
        <div class="info-mini-value">Pesisir Sumbar</div>
        <div class="info-mini-sub">Padang, Painan, Pariaman, Pasaman Barat</div>
      </div>
      <div class="info-card-mini">
        <div class="info-mini-header">
          <span class="info-mini-icon">⏱️</span>
          <span class="info-mini-label">Jangkauan Prediksi</span>
        </div>
        <div class="info-mini-value">3 – 9 Jam</div>
        <div class="info-mini-sub">Interval 3 jam per langkah prediksi</div>
      </div>
      <div class="info-card-mini">
        <div class="info-mini-header">
          <span class="info-mini-icon">🛡️</span>
          <span class="info-mini-label">Radius Pantau</span>
        </div>
        <div class="info-mini-value">500 km</div>
        <div class="info-mini-sub">Estimasi jarak ke garis pantai terdekat</div>
      </div>
    </div>

    <!-- ===== CARA KERJA SISTEM ===== -->
    <div class="page-panel" style="margin-bottom: 20px;">
      <div class="page-section-header">
        <h2 class="section-title">⚙️ Cara Kerja Sistem</h2>
        <p class="section-subtitle">Dari data observasi mentah hingga hasil prediksi lintasan dan laporan peringatan dini.</p>
      </div>

      <div class="pipeline-grid">
        <div class="pipeline-step">
          <div class="step-num">01</div>
          <div class="step-icon">📡</div>
          <div class="step-title">Input Observasi</div>
          <div class="step-desc">8 titik posisi siklon (Lat, Lon, kecepatan angin, tekanan udara) dengan interval 3 jam.</div>
        </div>

        <div class="pipeline-arrow">›</div>

        <div class="pipeline-step">
          <div class="step-num">02</div>
          <div class="step-icon">🔧</div>
          <div class="step-title">Ekstraksi Fitur</div>
          <div class="step-desc">Menghitung jarak Haversine, bearing, kecepatan, dan fitur siklikal dari data mentah.</div>
        </div>

        <div class="pipeline-arrow">›</div>

        <div class="pipeline-step">
          <div class="step-num">03</div>
          <div class="step-icon">🧠</div>
          <div class="step-title">Model LSTM</div>
          <div class="step-desc">Inferensi rekursif menggunakan model ONNX untuk 1–3 langkah prediksi ke depan.</div>
        </div>

        <div class="pipeline-arrow">›</div>

        <div class="pipeline-step">
          <div class="step-num">04</div>
          <div class="step-icon">🗺️</div>
          <div class="step-title">Kerucut Ketidakpastian</div>
          <div class="step-desc">Proyeksi lintasan + area ketidakpastian (±20–75 km) divisualisasikan di peta.</div>
        </div>

        <div class="pipeline-arrow">›</div>

        <div class="pipeline-step">
          <div class="step-num">05</div>
          <div class="step-icon">📋</div>
          <div class="step-title">Laporan Peringatan</div>
          <div class="step-desc">Laporan PDF dengan analisis ancaman ke pesisir, sesuai standar BMKG/BPBD.</div>
        </div>
      </div>
    </div>

    <!-- ===== MENU HALAMAN ===== -->
    <div style="margin-bottom: 20px;">
      <h2 class="section-nav-title">Halaman Aplikasi</h2>
      <div class="feature-matrix">
        <a href="/prediksi" class="matrix-card">
          <div class="matrix-header">
            <span class="matrix-icon">🌀</span>
            <span class="matrix-status status-active">UTAMA</span>
          </div>
          <div class="matrix-title">Prediksi Siklon</div>
          <div class="matrix-desc">Input 8 titik observasi, jalankan model LSTM, dan lihat prediksi lintasan berikut analisis ancaman ke pesisir.</div>
          <div class="matrix-footer">Buka →</div>
        </a>

        <a href="/dashboard" class="matrix-card">
          <div class="matrix-header">
            <span class="matrix-icon">🗺️</span>
            <span class="matrix-status">ANALISIS</span>
          </div>
          <div class="matrix-title">Dashboard Prediksi</div>
          <div class="matrix-desc">Bandingkan hasil aktual vs prediksi model, filter radius dari Sumatera Barat, dan lihat metrik RMSE & MAE.</div>
          <div class="matrix-footer">Buka →</div>
        </a>

        <a href="/data-siklon" class="matrix-card">
          <div class="matrix-header">
            <span class="matrix-icon">📂</span>
            <span class="matrix-status">DATA</span>
          </div>
          <div class="matrix-title">Data Observasi</div>
          <div class="matrix-desc">Jelajahi rekaman historis siklon (1980–2025) dari dataset IBTrACS, lengkap dengan parameter fisis dan status data.</div>
          <div class="matrix-footer">Lihat Data →</div>
        </a>

        <a href="/evaluasi" class="matrix-card">
          <div class="matrix-header">
            <span class="matrix-icon">📊</span>
            <span class="matrix-status">EVALUASI</span>
          </div>
          <div class="matrix-title">Evaluasi Akurasi</div>
          <div class="matrix-desc">Statistik deviasi spasial, grafik error per koordinat, distribusi frekuensi, dan ekspor hasil ke CSV.</div>
          <div class="matrix-footer">Lihat Evaluasi →</div>
        </a>

        <a href="/tentang" class="matrix-card">
          <div class="matrix-header">
            <span class="matrix-icon">📖</span>
            <span class="matrix-status">RISET</span>
          </div>
          <div class="matrix-title">Tentang Penelitian</div>
          <div class="matrix-desc">Dokumentasi eksperimen multi-skenario (GAB, NI, SI), perbandingan performa antar model, dan metodologi penelitian.</div>
          <div class="matrix-footer">Baca →</div>
        </a>
      </div>
    </div>

  </div>
</Layout>

<style>
  /* ===== HERO ===== */
  .hero-card {
    background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 60%, #172554 100%);
    border-radius: 16px;
    padding: 28px;
    color: white;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 22px;
    align-items: center;
    box-shadow: 0 10px 24px -4px rgba(30, 58, 138, 0.3);
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
  }
  .hero-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(59,130,246,0.2) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.74rem;
    font-weight: 700;
    color: #93C5FD;
    letter-spacing: 0.03em;
    margin-bottom: 10px;
  }
  .hero-badge-logo {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    object-fit: cover;
    margin-right: 6px;
    border: 1px solid rgba(255,255,255,0.3);
    flex-shrink: 0;
  }
  .hero-title {
    font-size: clamp(1.2rem, 3.5vw, 1.7rem);
    font-weight: 900;
    color: #FFFFFF;
    margin: 0 0 12px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .hero-desc {
    color: #DBEAFE;
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0 0 18px;
  }
  .hero-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .btn-hero-glow {
    background: #2563EB !important;
    box-shadow: 0 4px 12px rgba(37,99,235,0.45);
  }
  .btn-hero-glow:hover {
    background: #1D4ED8 !important;
    box-shadow: 0 6px 18px rgba(37,99,235,0.65);
  }
  .btn-hero-secondary {
    background: rgba(255,255,255,0.12);
    color: #FFFFFF;
    border: 1.5px solid rgba(255,255,255,0.3);
    padding: 8px 14px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.84rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.15s;
    min-height: 40px;
  }
  .btn-hero-secondary:hover { background: rgba(255,255,255,0.22); }
  .btn-hero-outline {
    background: transparent;
    color: #93C5FD;
    border: 1.5px solid rgba(147,197,253,0.4);
    padding: 8px 14px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.84rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.15s;
    min-height: 40px;
  }
  .btn-hero-outline:hover { background: rgba(147,197,253,0.15); color: white; }
  .hero-image {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    height: 100%;
    min-height: 240px;
    display: flex;
    align-items: center;
    background: #0B1329;
  }
  .hero-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  /* ===== INFO CARDS MINI ===== */
  .info-card-mini {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px;
    box-shadow: 0 2px 6px rgba(15,23,42,0.03);
    transition: all 0.2s ease;
  }
  .info-card-mini:hover {
    border-color: #93C5FD;
    box-shadow: 0 4px 14px rgba(30,58,138,0.07);
    transform: translateY(-2px);
  }
  .info-mini-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .info-mini-icon { font-size: 1.2rem; }
  .info-mini-label {
    font-size: 0.68rem;
    font-weight: 800;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .info-mini-value {
    font-size: clamp(1.1rem, 3vw, 1.3rem);
    font-weight: 900;
    color: #1E3A8A;
    line-height: 1.15;
    margin-bottom: 4px;
  }
  .info-mini-sub { font-size: 0.74rem; color: #64748B; line-height: 1.4; }

  /* ===== PIPELINE ===== */
  .pipeline-grid {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 6px;
    scrollbar-width: thin;
  }
  .pipeline-step {
    flex: 1;
    min-width: 130px;
    background: #F8FAFC;
    border: 1.5px solid #E2E8F0;
    border-radius: 10px;
    padding: 12px 10px;
    text-align: center;
    position: relative;
    transition: all 0.15s;
  }
  .pipeline-step:hover { background: #EFF6FF; border-color: #93C5FD; }
  .step-num { position: absolute; top: 6px; left: 8px; font-size: 0.68rem; font-weight: 900; color: #94A3B8; }
  .step-icon { font-size: 1.4rem; margin: 2px 0 4px; }
  .step-title { font-size: 0.82rem; font-weight: 800; color: #1E3A8A; margin-bottom: 3px; }
  .step-desc { font-size: 0.71rem; color: #64748B; line-height: 1.35; }
  .pipeline-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94A3B8;
    font-size: 1.2rem;
    font-weight: 900;
    padding: 0 2px;
    flex-shrink: 0;
  }

  /* ===== MENU NAVIGASI ===== */
  .section-nav-title {
    font-size: 0.9rem;
    font-weight: 800;
    color: #1E3A8A;
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .feature-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }
  .matrix-card {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 12px;
    padding: 16px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: all 0.15s ease;
  }
  .matrix-card:hover {
    border-color: #1E3A8A;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(30,58,138,0.08);
  }
  .matrix-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .matrix-icon { font-size: 1.4rem; }
  .matrix-status {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 5px;
    background: #F1F5F9;
    color: #475569;
    letter-spacing: 0.04em;
  }
  .matrix-status.status-active { background: #DBEAFE; color: #1E3A8A; }
  .matrix-title { font-size: 0.92rem; font-weight: 800; color: #0F172A; margin-bottom: 5px; }
  .matrix-desc { font-size: 0.78rem; color: #475569; line-height: 1.45; flex-grow: 1; margin-bottom: 10px; }
  .matrix-footer { font-size: 0.78rem; font-weight: 800; color: #2563EB; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .hero-card { grid-template-columns: 1fr; padding: 20px; gap: 16px; }
    .hero-image { min-height: 180px; height: 180px; }
    .pipeline-grid { flex-wrap: wrap; }
    .pipeline-arrow { display: none; }
    .pipeline-step { min-width: calc(50% - 6px); }
  }
  @media (max-width: 640px) {
    .hero-title { font-size: 1.25rem; }
    .hero-desc { font-size: 0.82rem; margin-bottom: 14px; }
    .hero-actions { width: 100%; }
    .hero-actions .btn,
    .hero-actions .btn-hero-secondary,
    .hero-actions .btn-hero-outline { width: 100%; justify-content: center; }
    .pipeline-step { min-width: 100%; text-align: left; padding: 10px 12px; }
    .step-icon { display: inline-block; vertical-align: middle; margin: 0 6px 0 0; }
    .step-title { display: inline-block; vertical-align: middle; }
    .step-num { position: static; display: inline-block; margin-right: 6px; }
  }
</style>

---
export interface Props {
  title: string;
}
const { title } = Astro.props;
const siteUrl = (
  import.meta.env.PUBLIC_SITE_URL ||
  (process.env.VERCEL_PROJECT_PRODUCTION_URL ? `https://${process.env.VERCEL_PROJECT_PRODUCTION_URL}` : null) ||
  (process.env.VERCEL_URL ? `https://${process.env.VERCEL_URL}` : null) ||
  Astro.site?.toString().replace(/\/$/, '') ||
  'https://prediksi.ikhwann.my.id'
).replace(/\/$/, '');

const currentPath = Astro.url.pathname;
const canonicalUrl = `${siteUrl}${currentPath === '/' ? '' : currentPath}`;
const ogImageUrl = `${siteUrl}/og.png`;
const pageTitle = `${title} — Sistem Prediksi Siklon Tropis`;
const pageDescription = 'Sistem prediksi lintasan siklon tropis berbasis LSTM untuk mitigasi bencana Sumatera Barat';

const navItems = [
  { href: '/', label: 'Beranda', icon: '🏠' },
  { href: '/dashboard', label: 'Dashboard Prediksi', icon: '🗺️' },
  { href: '/prediksi', label: 'Prediksi Siklon', icon: '🔮' },
  { href: '/data-siklon', label: 'Data Observasi', icon: '📊' },
  { href: '/evaluasi', label: 'Evaluasi Akurasi', icon: '📈' },
  { href: '/tentang', label: 'Tentang Model', icon: 'ℹ️' },
];
